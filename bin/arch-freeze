#!/bin/bash
# ==============================================================================
# arch-freeze: Safe terminal-based utility to toggle Normal and Frozen (Immutable)
# modes on Arch Linux using native systemd-boot UKIs and OverlayFS.
# ==============================================================================

set -eo pipefail

readonly FROZEN_UKI="arch-linux-frozen.efi"
readonly NORMAL_UKI="arch-linux.efi"

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Determine invocation mode (arch-freeze vs arch-unfreeze)
COMMAND_NAME="$(basename "$0")"

# Flags
DRY_RUN=false
NON_INTERACTIVE=false
PERMANENT=false

usage() {
    echo -e "${BOLD}Usage:${NC}"
    echo -e "    arch-freeze [options]           Set next boot to FROZEN mode (ephemeral root)"
    echo -e "    arch-unfreeze [options]         Set next boot to NORMAL mode (persistent root)"
    echo -e "    arch-freeze status              Display current system, overlay & persistence status"
    echo -e ""
    echo -e "${BOLD}Options:${NC}"
    echo -e "    -s, --status                    Show current status and exit"
    echo -e "    -d, --dry-run                   Show actions without making changes"
    echo -e "    -y, --yes                       Skip confirmation prompts"
    echo -e "    -p, --permanent                 Set as default bootloader entry (instead of one-shot)"
    echo -e "    -h, --help                      Show this help message"
    echo -e ""
    echo -e "${BOLD}Description:${NC}"
    echo -e "    ${BOLD}NORMAL Mode:${NC} Root filesystem is persistent and writable. Package installs,"
    echo -e "                 updates, and system configurations persist across reboots."
    echo -e "    ${BOLD}FROZEN Mode:${NC} Underlying root filesystem is read-only. All changes are"
    echo -e "                 written to an in-memory OverlayFS tmpfs and vanish on reboot."
    echo -e "                 /home, /var/log, and Incus storage remain 100% persistent."
}

# Check if currently running in frozen mode
is_frozen_active() {
    if findmnt -no FSTYPE / 2>/dev/null | grep -q "overlay"; then
        return 0
    fi
    if grep -q -E '(arch\.frozen|systemd\.volatile=overlay|arch-freeze)' /proc/cmdline; then
        return 0
    fi
    return 1
}

# Detect next boot mode
get_next_boot_mode() {
    local oneshot_file
    oneshot_file=$(ls /sys/firmware/efi/efivars/LoaderEntryOneshot-* 2>/dev/null | head -n 1 || true)
    if [ -n "$oneshot_file" ] && [ -f "$oneshot_file" ]; then
        local oneshot_val
        oneshot_val=$(tr -d '\000' < "$oneshot_file" 2>/dev/null | tr -cd '[:print:]' || true)
        if [[ "$oneshot_val" =~ $FROZEN_UKI ]]; then
            echo "FROZEN (One-shot next boot: $FROZEN_UKI)"
            return
        elif [[ "$oneshot_val" =~ $NORMAL_UKI ]]; then
            echo "NORMAL (One-shot next boot: $NORMAL_UKI)"
            return
        fi
    fi

    local default_file
    default_file=$(ls /sys/firmware/efi/efivars/LoaderEntryDefault-* 2>/dev/null | head -n 1 || true)
    if [ -n "$default_file" ] && [ -f "$default_file" ]; then
        local def_val
        def_val=$(tr -d '\000' < "$default_file" 2>/dev/null | tr -cd '[:print:]' || true)
        if [[ "$def_val" =~ $FROZEN_UKI ]]; then
            echo "FROZEN (Default entry: $FROZEN_UKI)"
            return
        fi
    fi

    echo "NORMAL (Default entry: $NORMAL_UKI)"
}

show_status() {
    echo -e "${BOLD}======================================================${NC}"
    echo -e "${BOLD}               ARCH-FREEZE SYSTEM STATUS              ${NC}"
    echo -e "${BOLD}======================================================${NC}"

    # 1. Current Mode
    if is_frozen_active; then
        echo -e "  Current Mode:               ${CYAN}${BOLD}FROZEN${NC} (Ephemeral RAM Root)"
    else
        echo -e "  Current Mode:               ${GREEN}${BOLD}NORMAL${NC} (Persistent Root)"
    fi

    # 2. Next Boot Mode
    local next_boot
    next_boot="$(get_next_boot_mode)"
    if [[ "$next_boot" =~ "FROZEN" ]]; then
        echo -e "  Next Boot Mode:             ${CYAN}${BOLD}${next_boot}${NC}"
    else
        echo -e "  Next Boot Mode:             ${GREEN}${BOLD}${next_boot}${NC}"
    fi

    # 3. Root Filesystem
    local root_src root_fstype root_opts
    root_src=$(findmnt -no SOURCE / 2>/dev/null || echo "Unknown")
    root_fstype=$(findmnt -no FSTYPE / 2>/dev/null || echo "Unknown")
    root_opts=$(findmnt -no OPTIONS / 2>/dev/null || echo "Unknown")
    echo -e "  Root Filesystem:            $root_src ($root_fstype, $root_opts)"

    # 4. Overlay Status
    if is_frozen_active; then
        local cow_usage
        cow_usage=$(df -h /run/arch-freeze/cow 2>/dev/null | awk 'NR==2{print $3 " used / " $2 " total (" $5 ")"}')
        echo -e "  Overlay Status:             ${CYAN}ACTIVE${NC} (RAM tmpfs: ${cow_usage:-active})"
    else
        echo -e "  Overlay Status:             ${GREEN}INACTIVE${NC} (Direct Native Mount)"
    fi

    # 5. Persistent /home Status
    local home_src home_fstype
    home_src=$(findmnt -no SOURCE /home 2>/dev/null || echo "")
    home_fstype=$(findmnt -no FSTYPE /home 2>/dev/null || echo "")
    if [ -n "$home_src" ]; then
        echo -e "  Persistent /home Status:    ${GREEN}PERSISTENT${NC} ($home_src, $home_fstype)"
    else
        echo -e "  Persistent /home Status:    ${YELLOW}WARNING${NC} (/home not mounted separately!)"
    fi

    # 6. Incus Storage Location & Persistence
    local incus_mount incus_src
    incus_mount=$(findmnt -no TARGET /var/lib/incus 2>/dev/null || echo "")
    incus_src=$(findmnt -no SOURCE /var/lib/incus 2>/dev/null || echo "")
    if [ "$incus_mount" = "/var/lib/incus" ]; then
        echo -e "  Incus Storage Location:     /var/lib/incus -> $incus_src"
        echo -e "  Incus Storage Persistence:  ${GREEN}PERSISTENT${NC} (Isolated Btrfs Subvolume)"
    else
        local incus_pool_src
        incus_pool_src=$(incus storage show default 2>/dev/null | awk '/^  source:/{print $2}' || true)
        echo -e "  Incus Storage Location:     ${incus_pool_src:-/var/lib/incus}"
        if is_frozen_active; then
            echo -e "  Incus Storage Persistence:  ${RED}WARNING${NC} (/var/lib/incus is not a separate subvolume mount!)"
        else
            echo -e "  Incus Storage Persistence:  ${YELLOW}HOST-BOUND${NC} (On root subvolume; migration recommended)"
        fi
    fi

    echo -e "${BOLD}======================================================${NC}"
}

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${YELLOW}[!] Root privileges required. Re-running with sudo...${NC}"
        exec sudo "$0" "$@"
    fi
}

check_bootloader_entry() {
    local target_entry="$1"
    # Check if target UKI exists in /boot/EFI/Linux
    if [ ! -f "/boot/EFI/Linux/$target_entry" ]; then
        echo -e "${RED}[ERROR] Boot entry /boot/EFI/Linux/$target_entry not found!${NC}"
        echo -e "Please run 'sudo ./install.sh' to generate the UKI boot entries."
        exit 1
    fi
}

set_freeze_mode() {
    echo -e "${BOLD}Target Mode:${NC} ${CYAN}${BOLD}FROZEN${NC} (Ephemeral Volatile Root)"
    echo -e "The next boot will load ${BOLD}$FROZEN_UKI${NC}."
    echo -e "Underlying root filesystem will be read-only. All OS changes disappear upon reboot."
    echo -e "User data (/home) and Incus VMs/containers remain fully persistent."
    echo ""

    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}[DRY-RUN] Would run: bootctl set-oneshot $FROZEN_UKI${NC}"
        return 0
    fi

    if [ "$NON_INTERACTIVE" = false ]; then
        read -r -p "Set next boot to FROZEN mode? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Operation cancelled."
            exit 0
        fi
    fi

    require_root "$@"
    check_bootloader_entry "$FROZEN_UKI"

    if [ "$PERMANENT" = true ]; then
        bootctl set-default "$FROZEN_UKI"
        echo -e "${GREEN}[OK] Set default bootloader entry to: $FROZEN_UKI (Permanent Frozen)${NC}"
    else
        bootctl set-oneshot "$FROZEN_UKI"
        echo -e "${GREEN}[OK] Next boot is configured for FROZEN mode ($FROZEN_UKI).${NC}"
    fi

    if [ "$NON_INTERACTIVE" = false ]; then
        read -r -p "Would you like to reboot now? [y/N]: " do_reboot
        if [[ "$do_reboot" =~ ^[Yy]$ ]]; then
            echo -e "${BLUE}Rebooting into Frozen mode...${NC}"
            systemctl reboot
        fi
    fi
}

set_unfreeze_mode() {
    echo -e "${BOLD}Target Mode:${NC} ${GREEN}${BOLD}NORMAL${NC} (Persistent Administration Mode)"
    echo -e "The next boot will load ${BOLD}$NORMAL_UKI${NC}."
    echo -e "The root filesystem will be writable. Software installations and updates will persist."
    echo ""

    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}[DRY-RUN] Would run: bootctl set-default $NORMAL_UKI; bootctl set-oneshot \"\"${NC}"
        return 0
    fi

    if [ "$NON_INTERACTIVE" = false ]; then
        read -r -p "Set next boot to NORMAL mode? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            echo "Operation cancelled."
            exit 0
        fi
    fi

    require_root "$@"
    check_bootloader_entry "$NORMAL_UKI"

    # Reset default and clear oneshot
    bootctl set-default "$NORMAL_UKI"
    bootctl set-oneshot "" 2>/dev/null || true
    echo -e "${GREEN}[OK] System configured to boot in NORMAL mode ($NORMAL_UKI).${NC}"

    if [ "$NON_INTERACTIVE" = false ]; then
        read -r -p "Would you like to reboot now? [y/N]: " do_reboot
        if [[ "$do_reboot" =~ ^[Yy]$ ]]; then
            echo -e "${BLUE}Rebooting into Normal mode...${NC}"
            systemctl reboot
        fi
    fi
}

# Parse Command Line Arguments
ACTION="freeze"
if [ "$COMMAND_NAME" = "arch-unfreeze" ]; then
    ACTION="unfreeze"
fi

while [ $# -gt 0 ]; do
    case "$1" in
        status|-s|--status)
            ACTION="status"
            shift
            ;;
        unfreeze)
            ACTION="unfreeze"
            shift
            ;;
        freeze)
            ACTION="freeze"
            shift
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -y|--yes|--non-interactive)
            NON_INTERACTIVE=true
            shift
            ;;
        -p|--permanent)
            PERMANENT=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            usage
            exit 1
            ;;
    esac
done

case "$ACTION" in
    status)
        show_status
        ;;
    freeze)
        set_freeze_mode
        ;;
    unfreeze)
        set_unfreeze_mode
        ;;
esac
